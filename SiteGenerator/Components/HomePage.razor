@using System.Globalization

<Layout Title="Maciej Pałubicki · .NET Software Engineer"
        Description="Maciej Pałubicki, .NET software engineer from Koszalin, Poland. C#, ASP.NET Core, gRPC, microservices and SQL."
        IsHome="true">

    <section class="hero">
        <div class="hero-main">
            <p class="status">Currently learning Blazor</p>
            <h1>Maciej Pałubicki</h1>
            <p class="hero-role">.NET Software Engineer</p>
            <p class="lead">
                I build backend services in C# and .NET at i4B: ASP.NET Core APIs, gRPC and
                message-driven microservices, SQL Server and PostgreSQL databases, and migrations
                of legacy .NET Framework systems to modern .NET.
            </p>
            <ul class="hero-links">
                <li><a class="primary" href="mailto:@Site.Email">Email me</a></li>
                <li><a href="@Site.GitHub">GitHub</a></li>
                <li><a href="@Site.LinkedIn">LinkedIn</a></li>
            </ul>
        </div>
        <aside class="hero-card" aria-label="Quick facts">
            <img src="images/logo.svg" alt="" width="52" height="52">
            <dl>
                <div><dt>Current role</dt><dd>Software Developer at i4B</dd></div>
                <div><dt>Based in</dt><dd>Koszalin, Poland</dd></div>
                <div><dt>Experience</dt><dd>.NET since 2022</dd></div>
                <div><dt>Focus</dt><dd>Backend, APIs, microservices</dd></div>
            </dl>
        </aside>
    </section>

    @if (Posts.Count > 0)
    {
        <section id="posts">
            <h2>Latest posts</h2>
            <PostList Posts="Posts" />
            <p class="more"><a href="posts.html">All posts &rarr;</a></p>
        </section>
    }

    <section id="experience">
        <h2>Experience</h2>
        <ol class="timeline">
            @foreach (var job in Experience)
            {
                <li class="job">
                    <div class="job-head">
                        <h3>
                            @job.Title <span class="company">· @job.Company</span>
                            @if (job.Duration.EndsWith("present"))
                            {
                                <span class="badge">Current</span>
                            }
                        </h3>
                        <span class="meta">@job.Duration</span>
                    </div>
                    <p class="meta">@job.Location · @job.EmploymentType</p>
                    <p>@job.Description</p>
                    <Tags Items="job.Technologies" />
                </li>
            }
        </ol>
    </section>

    <section id="projects">
        <h2>Projects</h2>
        <div class="cards">
            @foreach (var project in Projects)
            {
                <article class="card">
                    <h3>@project.Title</h3>
                    <p>@project.Description</p>
                    <Tags Items="project.Tech" />
                </article>
            }
        </div>
    </section>

    @if (GitHub is not null)
    {
        <section id="github">
            <h2>GitHub</h2>
            <dl class="stat-tiles">
                @foreach (var (value, label) in StatsCards.Tiles(GitHub))
                {
                    <div class="stat">
                        <dt>@label</dt>
                        <dd>@value</dd>
                    </div>
                }
            </dl>

            @if (GitHub.Contributions is { Count: > 0 } days)
            {
                var cells = ContributionCalendar.Cells(days);
                <figure class="panel">
                    <figcaption>@GitHub.TotalContributions.ToString("N0", CultureInfo.InvariantCulture) contributions in the last year</figcaption>
                    <div class="heatmap-scroll">
                        <div class="heatmap" role="img" aria-label="@($"Contribution calendar: {GitHub.TotalContributions} contributions in the last year, longest streak {GitHub.LongestStreak} days")">
                            <div class="heatmap-months" aria-hidden="true">
                                @foreach (var (week, month) in ContributionCalendar.MonthLabels(cells))
                                {
                                    <span style="grid-column: @(week + 1)">@month</span>
                                }
                            </div>
                            <div class="heatmap-days" aria-hidden="true"><span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span></div>
                            <div class="heatmap-grid">
                                @for (var i = 0; i < cells[0].Weekday; i++)
                                {
                                    <i></i>
                                }
                                @foreach (var cell in cells)
                                {
                                    <span data-level="@GitHub.Level(cell.Day.Count)" title="@Tip(cell.Day)"></span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="heatmap-legend" aria-hidden="true">
                        Less
                        @for (var level = 0; level <= 4; level++)
                        {
                            <span data-level="@level"></span>
                        }
                        More
                    </div>
                    <details class="table-view">
                        <summary>Show as table</summary>
                        <table>
                            <thead><tr><th scope="col">Week of</th><th scope="col">Contributions</th></tr></thead>
                            <tbody>
                                @foreach (var week in cells.GroupBy(c => c.Week).OrderByDescending(w => w.Key))
                                {
                                    <tr><td>@week.Min(c => c.Day.Date).ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td><td>@week.Sum(c => c.Day.Count)</td></tr>
                                }
                            </tbody>
                        </table>
                    </details>
                </figure>
            }

            <div class="github-grid">
                <figure class="panel">
                    <figcaption>Repositories by primary language</figcaption>
                    <ul class="bar-chart">
                        @foreach (var language in GitHub.Languages)
                        {
                            <li title="@($"{language.Language}: {language.Repositories} of {GitHub.Languages.Sum(l => l.Repositories)} repositories")">
                                <span class="bar-label">@language.Language</span>
                                <span class="bar-track">
                                    <span class="bar" style="--share: @BarShare(language)"></span>
                                    <span class="bar-value">@language.Repositories</span>
                                </span>
                            </li>
                        }
                    </ul>
                </figure>
                <div class="repo-cards">
                    @foreach (var repo in GitHub.Featured)
                    {
                        <a class="card repo-card" href="@repo.Url">
                            <h3>@repo.Name</h3>
                            <p>@repo.Description</p>
                            <span class="meta">@(repo.Language ?? "Repository")@(repo.Stars > 0 ? $" · ★ {repo.Stars}" : "")</span>
                        </a>
                    }
                </div>
            </div>
            <p class="more"><a href="@Site.GitHub?tab=repositories">All repositories on GitHub &rarr;</a></p>
        </section>
    }

    <section id="skills">
        <h2>Skills</h2>
        <div class="skill-grid">
            @foreach (var group in Skills)
            {
                <div class="skill-group">
                    <h3>@group.Category</h3>
                    <Tags Items="group.Items" />
                </div>
            }
        </div>
    </section>

    <section id="setup" class="prose">
        <h2>Setup</h2>
        <p>
            I run NixOS, and my whole machine is declared in one flake: system packages,
            Home Manager for user settings, the niri Wayland compositor with the Noctalia
            shell, and every tool I work with. Inputs are pinned, so the same config builds
            the same system, and a rollback is a single command. One palette, defined in my
            kitty config, themes the terminal, GTK, Qt, Neovim and this website.
        </p>
        <img class="screenshot" src="images/nixos-fastfetch.jpg" width="1200" height="515"
             alt="kitty terminal running fastfetch on NixOS 26.05 with the niri compositor">
        <dl class="details">
            <dt>OS</dt>
            <dd>NixOS 26.05, flakes, Home Manager</dd>
            <dt>Desktop</dt>
            <dd>niri (Wayland), Noctalia shell</dd>
            <dt>Terminal</dt>
            <dd>kitty, JetBrains Mono, Starship, tmux</dd>
            <dt>Editors</dt>
            <dd>Rider, VS Code, Neovim</dd>
            <dt>Tools</dt>
            <dd>Docker, Terraform, Bruno, DBeaver</dd>
        </dl>
        <p class="more">
            <a href="@(Site.GitHub)/nix-os-configuration">nix-os-configuration on GitHub &rarr;</a>
        </p>
    </section>

    <section id="about" class="prose">
        <h2>About</h2>
        <p>
            I started with .NET as a trainee at GlobalLogic in 2022 and joined i4B as an
            intern in 2023, where I now work as a software developer. My work centers on
            backend architecture in C# and .NET and on keeping older systems maintainable:
            refactoring, paying down technical debt and moving .NET Framework code to
            modern .NET with a cleaner structure. Right now I'm learning Blazor to build
            front ends without leaving the .NET stack.
        </p>
        <p>
            Outside of work I collect vinyl records and mechanical watches, play retro
            games (mostly Nintendo) and make pixel art. Photos of my records and other
            hobbies are in my <a href="collection.html">collection</a>.
        </p>
    </section>

    <section id="contact">
        <h2>Contact</h2>
        <div class="contact-card">
            <p>Email is the quickest way to reach me.</p>
            <dl class="details contact">
                <dt>Email</dt>
                <dd><a href="mailto:@Site.Email">@Site.Email</a> <button type="button" class="copy" data-copy="@Site.Email" hidden>Copy</button></dd>
                <dt>GitHub</dt>
                <dd><a href="@Site.GitHub">@Site.GitHub.Replace("https://", "")</a></dd>
                <dt>LinkedIn</dt>
                <dd><a href="@Site.LinkedIn">in/maciej-pałubicki</a></dd>
            </dl>
        </div>
    </section>
</Layout>

@code {
    /// <summary>The newest posts, already sorted.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Post> Posts { get; set; } = [];

    /// <summary>Null when GitHub could not be reached; the section is then left out.</summary>
    [Parameter] public GitHubStats? GitHub { get; set; }

    static string Tip(ContributionDay day) =>
        $"{(day.Count == 0 ? "No" : day.Count.ToString(CultureInfo.InvariantCulture))} contribution{(day.Count == 1 ? "" : "s")} on {day.Date.ToString("d MMM yyyy", CultureInfo.InvariantCulture)}";

    string BarShare(LanguageCount language) =>
        ((double)language.Repositories / GitHub!.Languages.Max(l => l.Repositories)).ToString("0.###", CultureInfo.InvariantCulture);

    record Job(string Title, string Company, string Location, string Duration, string EmploymentType, string Description, string[] Technologies);
    record Project(string Title, string Description, string[] Tech);
    record SkillGroup(string Category, string[] Items);

    static readonly Job[] Experience =
    [
        new("Software Developer", "i4B", "Koszalin, Poland", "Oct 2023 – present", "Full-time · Hybrid",
            "Building backend services in C# and .NET on top of SQL databases. Responsible for backend architecture, system integrations and ongoing maintenance.",
            ["C#", ".NET", "SQL", "AWS", "Python", "TypeScript"]),
        new("Intern", "i4B", "Koszalin, Poland", "Jul 2023 – Oct 2023", "Internship · On-site",
            "Backend development and SQL database work in C# and .NET.",
            ["C#", ".NET", "SQL"]),
        new("Trainee .NET Developer", "GlobalLogic", "Koszalin, Poland", "Jul 2022 – Sep 2022", "Internship",
            "Worked on backend projects in C# and .NET, using Git, SQL and Jira day to day.",
            ["C#", ".NET", "SQL", "Git", "Jira"]),
    ];

    static readonly Project[] Projects =
    [
        new("gRPC API in .NET",
            "gRPC service for communication between microservices, handling over 1 million requests per day.",
            ["C#", ".NET", "gRPC", "PostgreSQL", "Docker"]),
        new("AWS Glue ETL Pipeline",
            "ETL pipeline that processes large datasets with AWS Glue jobs, with Lambda functions automating the transform and load steps.",
            ["Python", "AWS Glue", "Lambda", "S3"]),
        new("Django Blog",
            "Blog application with user accounts, rich text editing and comments.",
            ["Python", "Django", "PostgreSQL"]),
    ];

    static readonly SkillGroup[] Skills =
    [
        new("C# / .NET", ["C#", "ASP.NET Core (Web API, MVC, minimal APIs)", "gRPC", "SignalR", "LINQ", "async/await", "Dependency injection", "Background services", "Blazor (learning)"]),
        new("Architecture", ["Clean Architecture", "DDD", "CQRS / MediatR", "Microservices", "SOLID", "Design patterns"]),
        new("Messaging", ["MassTransit", "Message queues", "Event-driven integration"]),
        new("Data access", ["Entity Framework Core", "Dapper", "SQL Server / T-SQL", "PostgreSQL", "Redis", "Query optimization", "Schema design"]),
        new("Security", ["Authentication & authorization", "JWT", "OAuth 2.0 / OpenID Connect", "ASP.NET Core Identity"]),
        new("Testing", ["TDD", "xUnit / NUnit", "Moq / NSubstitute", "Integration tests (WebApplicationFactory, Testcontainers)", "Architecture tests", "BenchmarkDotNet", "Profiling"]),
        new("Observability", ["Serilog", "OpenTelemetry", "Health checks", "Polly"]),
        new("Legacy systems", [".NET Framework to modern .NET migration", "Refactoring", "Technical debt reduction"]),
        new("Cloud & DevOps", ["AWS (EC2, S3, Lambda, RDS, DynamoDB)", "Azure", "Docker", "Terraform", "CI/CD", "Git", "Linux (NixOS)"]),
        new("Also", ["Python (FastAPI, Django)", "TypeScript / Node.js"]),
    ];
}
